                            "inputs": {
                                "question": "Can you tell me about your selection of tents?",
                                "customer": {
                                    "id": "3",
                                    "firstName": "Michael",
                                    "lastName": "Johnson",
                                    "age": 45,
                                    "email": "michaelj@example.com",
